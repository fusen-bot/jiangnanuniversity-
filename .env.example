# PY_AUTO — 编辑部财务统计管理系统
# 复制此文件为 .env 并填入你的凭证

# 本地路径配置
APP_DATA_DIR=./data
APP_OUTPUT_DIR=./output
APP_UPLOAD_DIR=./uploads
APP_NOTES_FILE=./data/notes.json
PAGE_FEE_FILE=./data/page_fee.xlsx
APP_WORKSPACE_DIR=.
APP_PROGRAM_DIR=./backend
AUTHOR_SAMPLE_PDF_PATH=
INTERNAL_KEYWORDS=
JOURNAL_BASE_URL=https://journal.example.invalid

# 讯飞星火 AI
SPARKAI_URL=wss://spark-api.xf-yun.com/v3.5/chat
SPARKAI_APP_ID=your_app_id_here
SPARKAI_API_KEY=your_api_key_here
SPARKAI_API_SECRET=your_api_secret_here
SPARKAI_DOMAIN=generalv3.5

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
